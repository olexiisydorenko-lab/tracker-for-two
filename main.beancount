; Спільний облік Олі й Марка. Лише штучні дані з домашнього завдання.

option "title" "Фінанси Олі й Марка"
option "operating_currency" "PLN"

; Операції, додані через Fava з телефона (кнопка «+»), пишуться в manual.beancount.
2026-07-31 custom "fava-option" "default-file" "manual.beancount"
2026-07-31 custom "fava-option" "language" "uk"

; --- Оля ---
2026-07-31 open Assets:Оля:Рахунок               PLN
2026-07-31 open Assets:Оля:Готівка               PLN
2026-07-31 open Income:Оля:Зарплата              PLN
2026-07-31 open Income:Оля:Інше                  PLN
2026-07-31 open Expenses:Оля:Житло               PLN
2026-07-31 open Expenses:Оля:Продукти            PLN
2026-07-31 open Expenses:Оля:Кафе                PLN
2026-07-31 open Expenses:Оля:Доставка-Їжі        PLN
2026-07-31 open Expenses:Оля:Транспорт           PLN
2026-07-31 open Expenses:Оля:Підписки            PLN
2026-07-31 open Expenses:Оля:Телефон             PLN
2026-07-31 open Expenses:Оля:Краса-Побут         PLN
2026-07-31 open Expenses:Оля:Спорт               PLN
2026-07-31 open Expenses:Оля:Без-Категорії       PLN

; --- Марко ---
2026-07-31 open Assets:Марко:Рахунок             PLN
2026-07-31 open Assets:Марко:Готівка             PLN
2026-07-31 open Income:Марко:Зарплата            PLN
2026-07-31 open Income:Марко:Інше                PLN
2026-07-31 open Expenses:Марко:Продукти          PLN
2026-07-31 open Expenses:Марко:Кафе              PLN
2026-07-31 open Expenses:Марко:Доставка-Їжі      PLN
2026-07-31 open Expenses:Марко:Транспорт         PLN
2026-07-31 open Expenses:Марко:Інтернет-Телефон  PLN
2026-07-31 open Expenses:Марко:Світло            PLN
2026-07-31 open Expenses:Марко:Спорт             PLN
2026-07-31 open Expenses:Марко:Підписки          PLN
2026-07-31 open Expenses:Марко:Розваги           PLN
