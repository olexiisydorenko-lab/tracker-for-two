2026-07-31 open Equity:Початкові-Залишки         PLN

; --- Початкові залишки ---
2026-07-31 * "Початковий залишок на рахунку Олі"
  Assets:Оля:Рахунок                         4500.00 PLN
  Equity:Початкові-Залишки

2026-07-31 * "Початковий залишок на рахунку Марка (з виписки)"
  Assets:Марко:Рахунок                       2860.40 PLN
  Equity:Початкові-Залишки

2026-08-01 balance Assets:Оля:Рахунок        4500.00 PLN
2026-08-01 balance Assets:Марко:Рахунок      2860.40 PLN

; --- Групи витрат ---
; Фіксовані: операції з тегом #fixed.
;   Оля: оренда, ZTM, Netflix, Spotify, Claude.ai, Play.
;   Марко: Orange, PGE, Zdrofit, YouTube Premium.
; Змінні: усі інші витрати — ними людина може керувати.

; --- Збережені запити (видно у Fava → Запит) ---
2026-07-31 query "змінні-по-місяцях" "
  SELECT year, month, root(account, 2) AS person, sum(number) AS variable
  WHERE account ~ '^Expenses' AND NOT ('fixed' IN tags)
  GROUP BY year, month, person
  ORDER BY year, month, person"

2026-07-31 query "фіксовані-по-місяцях" "
  SELECT year, month, root(account, 2) AS person, sum(number) AS fixed
  WHERE account ~ '^Expenses' AND 'fixed' IN tags
  GROUP BY year, month, person
  ORDER BY year, month, person"

2026-07-31 query "витрати-по-категоріях" "
  SELECT year, month, account, sum(number) AS total
  WHERE account ~ '^Expenses'
  GROUP BY year, month, account
  ORDER BY year, month, account"

; --- Операції ---
include "ledger/olya.beancount"
include "ledger/marko.beancount"
include "manual.beancount"
