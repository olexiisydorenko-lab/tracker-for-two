# Для локального запуску: скопіюйте в .env (він у .gitignore) і заповніть.
# На Render ці значення задаються в Environment сервісу, не в файлах.
TRACKER_USER=marko
# Або пароль, або (краще) його хеш:
#   python -c "from werkzeug.security import generate_password_hash as g; import getpass; print(g(getpass.getpass()))"
TRACKER_PASSWORD=
# TRACKER_PASSWORD_HASH=
# Випадковий ключ: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Лише на сервері без постійного диска (Render): збереження ручних операцій у GitHub
# GITHUB_TOKEN=
# GITHUB_REPO=owner/tracker-for-two
# Лише для локального запуску без HTTPS:
TRACKER_DEV=1
