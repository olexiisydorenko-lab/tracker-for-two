# Скопіюйте в .env (він у .gitignore) і заповніть. Реальні значення — лише на сервері.
TRACKER_USER=marko
# Хеш пароля: python -c "from werkzeug.security import generate_password_hash as g; print(g(input('Пароль: ')))"
TRACKER_PASSWORD_HASH=
# Випадковий ключ: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Лише для локального запуску без HTTPS:
# TRACKER_DEV=1
